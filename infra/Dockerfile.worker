FROM node:22-bookworm-slim AS javascript

FROM python:3.11-slim
COPY --from=javascript /usr/local/bin/node /usr/local/bin/node

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/packages/pipeline:/app/services/api:/app/services/worker

# 워커만 FFmpeg가 필요합니다. API 이미지에는 넣지 않습니다.
RUN apt-get update \
    && apt-get install --no-install-recommends -y ffmpeg fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# 자막 정렬(stable-ts)과 화자 분리(WhisperX)는 PyTorch를 씁니다. 기본 인덱스는
# 리눅스에서 CUDA 휠을 함께 받아 약 5GB가 늘어나므로 CPU 빌드를 먼저 고정합니다.
# 버전은 whisperx가 요구하는 범위(torch~=2.8.0, torchaudio~=2.8.0,
# torchvision~=0.23.0)와 맞춰야 합니다. whisperx를 올릴 때 이 줄도 함께 고칩니다.
# GPU가 필요하면 이 단계를 지우고 기본 인덱스로 설치한 뒤 R4_WHISPER_DEVICE를 바꿉니다.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
    "torch==2.8.0" "torchaudio==2.8.0" "torchvision==0.23.0"

WORKDIR /app

COPY pyproject.toml ./
COPY packages ./packages
RUN pip install --no-cache-dir ".[analysis,providers,imports,subtitles]"

COPY services ./services

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /home/appuser/.cache \
    && chown -R appuser:appuser /home/appuser/.cache
USER appuser

# 합성과 업로드는 큐를 나눕니다. 동시 실행 수는 서버 사양 측정 후 조정합니다.
CMD ["celery", "-A", "worker.celery_app.celery_app", "worker", "--loglevel=info", \
     "--queues=default,render,upload", "--concurrency=2"]
