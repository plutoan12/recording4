# 개발 환경 예시입니다. 실제 비밀은 커밋하지 않습니다.
# 운영 값은 서버 비밀 저장소에서 주입합니다.

R4_DATABASE_URL=postgresql+psycopg://recording4:devpass@localhost:5432/recording4
R4_REDIS_URL=redis://localhost:6379/0

# 최소 8자. 운영에서는 반드시 새로 생성합니다.
R4_JWT_SECRET=change-me-in-every-environment

# 개발은 MinIO 같은 S3 호환 저장소를 씁니다. 운영 값은 별도로 주입합니다.
R4_S3_BUCKET=recording4-dev
R4_S3_REGION=us-east-1
R4_S3_ENDPOINT_URL=http://localhost:9000
R4_S3_ACCESS_KEY_ID=minioadmin
R4_S3_SECRET_ACCESS_KEY=minioadmin
R4_S3_FORCE_PATH_STYLE=true

# 업로드·미리보기 제한
R4_UPLOAD_URL_TTL_SECONDS=900
R4_PREVIEW_URL_TTL_SECONDS=300

# Compose 내부 저장소와 브라우저 URL의 호스트가 다를 때 사용합니다.
# R4_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# 로컬 STT: 첫 요청 시 모델 다운로드가 발생할 수 있습니다.
R4_WHISPER_MODEL=small
R4_WHISPER_DEVICE=cpu
# PATH에 FFmpeg가 없을 때 절대 경로를 지정할 수 있습니다.
# R4_FFMPEG_BINARY=/usr/bin/ffmpeg

# 단계별 실행: 실제 공급자 사용 준비 후에만 켜세요.
R4_PAID_PROCESSING_ENABLED=false
R4_YOUTUBE_UPLOAD_ENABLED=false
# R4_GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-adc.json
# R4_ELEVENLABS_API_KEY=...
# R4_SYNC_API_KEY=...
# 공급자 계약에 맞춘 보수적인 USD 단가 상한. 아래는 값 없이 항목만 제시합니다.
# R4_TRANSLATE_USD_PER_1K_CHARS=...
# R4_TTS_USD_PER_1K_CHARS=...
# R4_LIPSYNC_USD_PER_SECOND=...
# R4_YOUTUBE_CREDENTIALS_FILE=/run/secrets/youtube-token.json
# R4_YOUTUBE_CHANNEL_ID=...
