+
+
+def test_long_cues_reach_aligner_without_duration_cap(tmp_path, monkeypatch):
+    import worker.analysis as analysis
+
+    original = [Cue(start=3, end=24.125, text="long human utterance")]
+
+    def tool(args):
+        from ffsubsync.subtitle_parser import GenericSubtitleParser
+
+        parser = GenericSubtitleParser(fmt="srt", max_subtitle_seconds=args.max_subtitle_seconds)
+        parsed = parser.fit_transform(args.srtin[0])
+        assert list(parsed)[0].end.total_seconds() == pytest.approx(24.125)
+        Path(args.srtout).write_text(dump_subtitles(original))
+        return {"offset_seconds": 0, "sync_was_successful": True}
+
+    monkeypatch.setattr(analysis, "_run_sync", tool)
+    actual, _ = sync_subtitles(tmp_path / "audio.wav", original)
+    assert actual == original
